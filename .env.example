# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- Database ----
MONGO_URI=mongodb://localhost:27017/jangdi

# ---- Auth ----
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
ALLOWED_EMAIL_DOMAIN=lamduan.mfu.ac.th

# ---- Google OAuth (FR-AUTH-03) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Google Maps / Geocoding (§5.3) ----
GOOGLE_MAPS_API_KEY=

# ---- Email / SMTP (FR-NOTIF-01, FR-AUTH-04) ----
# ตัวอย่างสำหรับ Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USER=your@gmail.com,
# EMAIL_PASS=App Password (ไม่ใช่รหัสผ่าน Gmail ปกติ ต้องสร้าง App Password ใน Google Account)
# ถ้าไม่ตั้งค่า 3 ตัวนี้ ระบบจะข้ามการส่งอีเมลจริงไปเงียบๆ (log แค่คำเตือน ไม่ crash)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=JangDi <noreply@jangdi.app>

# ---- Matching (FR-MATCH-01) ----
WORKER_MATCH_RADIUS_METERS=2000
PLATFORM_RADIUS_METERS=5000

# ---- Escrow fee (FR-PAY-03) ----
ESCROW_FEE_PERCENT_MIN=5
ESCROW_FEE_PERCENT_MAX=10
